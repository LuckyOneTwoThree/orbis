# ── Node / 前端 ────────────────────────────────────────────
node_modules/
dist/
*.local
*.tsbuildinfo

# 本地环境变量（可含个人路径 / 覆盖开关，如 VITE_ORBIS_API=mock）
.env
.env.local
.env.*.local

# ── Rust ──────────────────────────────────────────────────
# 构建产物不入库；但 **Cargo.lock 要入库** —— 这是应用而非库，
# 需要可复现构建（pm/04-技术设计.md §2.2 依赖治理）。
target/

# ── 编辑器 / 系统 ──────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/

# Obsidian 在工作区内打开过（仓库同时是知识库的一角）
.obsidian/

# 编辑器缓存
.vite/

# ── 智能体工作区 ───────────────────────────────────────────
# 项目记忆与脚本工件：本地有用，但不属于产品交付物
.workbuddy/

# ── 本地实测产物（不提交）──────────────────────────────────
# 真机实测可能产生的临时抓包 / 日志 / 备份样本
*.pcapng
*.har
/tmp-local/

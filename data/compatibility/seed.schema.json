{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbis.local/schema/compatibility-seed-0.1.0.json",
  "title": "Orbis Compatibility Seed Table",
  "description": "游戏版本 × 工具兼容状态的权威数据源（P0-C §1.1）。单源权威：CompatibilityEngine 只读本文件，Tool Manifest 不承载兼容性字段。",
  "type": "object",
  "required": ["schema_version", "updated_at", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0",
      "description": "加载器按此值校验；不符 → 全部查询返回 Unknown（不崩溃，02 C4 验收）"
    },
    "updated_at": { "type": "string", "format": "date" },
    "maintainer": { "type": "string", "description": "MVP 阶段为项目维护者；社区共建后为署名列表（00 §11.2）" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "gameId": {
      "type": "string",
      "enum": [
        "genshin-impact",
        "honkai-star-rail",
        "zenless-zone-zero",
        "wuthering-waves",
        "arknights-endfield"
      ]
    },
    "toolId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$",
      "description": "namespace/name；内置 = orbis-builtin/*，随包 = orbis-bundled/*，未来社区 = community/*（P0-C §1.2）"
    },
    "status": {
      "type": "string",
      "enum": ["Verified", "Compatible", "Unknown", "Incompatible", "Deprecated"],
      "description": "五态定义见 P0-C §2.1。Verified = 有直接验证证据；Compatible = 原理/上游声明推断可用"
    },
    "entry": {
      "type": "object",
      "required": ["game_id", "tool_id", "risk_level", "compatibility"],
      "additionalProperties": false,
      "properties": {
        "game_id": { "$ref": "#/$defs/gameId" },
        "tool_id": { "$ref": "#/$defs/toolId" },
        "risk_level": {
          "type": "string",
          "enum": ["L1", "L2", "L3"],
          "description": "展示用；权威值在 Tool Manifest（P0-C §1.2）"
        },
        "compatibility": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/compatibilityRecord" }
        }
      }
    },
    "compatibilityRecord": {
      "type": "object",
      "required": ["game_version", "status"],
      "additionalProperties": false,
      "properties": {
        "game_version": {
          "type": "string",
          "description": "exact 模式下为 major.minor（如 \"2.7\"）；prefix 模式下为 \"3.x\" 形式"
        },
        "version_match": {
          "type": "string",
          "enum": ["exact", "prefix"],
          "default": "exact",
          "description": "prefix + \"3.x\" 匹配 3.0–3.9；缺省 = 精确匹配（P0-C §1.3）"
        },
        "status": { "$ref": "#/$defs/status" },
        "verified_at": { "type": "string", "format": "date" },
        "verified_by": { "type": "string", "description": "P0 记录锚点 / 社区链接 / community 贡献者署名" },
        "evidence": {
          "type": "array",
          "items": { "type": "string" },
          "description": "证据链接或描述（可校验性，00 §11「可导出、可校验」）"
        },
        "notes": { "type": "string", "description": "工程备注：键名、写入语义、失效原因等" }
      },
      "allOf": [
        {
          "if": { "properties": { "version_match": { "const": "prefix" } }, "required": ["version_match"] },
          "then": {
            "properties": {
              "game_version": { "pattern": "^[0-9]+\\.x$" }
            }
          },
          "else": {
            "properties": {
              "game_version": { "pattern": "^[0-9]+\\.[0-9]+$" }
            }
          }
        }
      ]
    }
  }
}
